POSTGRES_DB=eduflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

DATABASE_URL=postgresql+psycopg://postgres:your_password_here@post_db:5432/eduflow
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/eduflow_test
SECRET_KEY=replace_with_your_secret_key
PORTAL_STUDY_URL_TEMPLATE=
PORTAL_STUDY_API_TOKEN=

FINIK_ENV=beta
FINIK_API_KEY=replace_with_your_finik_api_key
FINIK_ACCOUNT_ID=replace_with_your_finik_account_id
FINIK_PRIVATE_KEY_PATH=/path/to/finik_private.pem
FINIK_PUBLIC_KEY_PATH=/path/to/finik_public.pem
FINIK_WEBHOOK_URL=https://example.com/webhooks/finik
FINIK_REDIRECT_URL=https://example.com/payment/result